{
  "openapi": "3.1.0",
  "info": {
    "title": "Channel Book AI API",
    "description": "API RESTful for Channel",
    "version": "1.0.0"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Read Root",
        "operationId": "read_root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "tags": [
          "Chat"
        ],
        "summary": "Chat With Mascot",
        "description": "Endpoint utama untuk ngobrol dengan AI.\n- **message**: Pesan yang ingin dikirim\n- **mascot**: Pilih antara \"narra\" (fiksi/santai) atau \"syra\" (non-fiksi/formal)",
        "operationId": "chat_with_mascot_api_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "400": {
            "description": "Mascot not found (Bad Request)"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Pesan teks dari pengguna",
            "example": "Halo, ada rekomendasi buku?"
          },
          "mascot": {
            "type": "string",
            "title": "Mascot",
            "description": "Pilihan maskot: 'narra' atau 'syra'",
            "example": "narra"
          }
        },
        "type": "object",
        "required": [
          "message",
          "mascot"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "reply": {
            "type": "string",
            "title": "Reply",
            "description": "Balasan dari maskot AI",
            "example": "Ini adalah rekomendasi buku yang bagus untukmu!"
          },
          "mascot": {
            "type": "string",
            "title": "Mascot",
            "description": "Maskot yang membalas",
            "example": "narra"
          }
        },
        "type": "object",
        "required": [
          "reply",
          "mascot"
        ],
        "title": "ChatResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}